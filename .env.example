NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Host serving the GraphQL indexer paths (/registry/graphql, /candles/graphql).
# Every subgraph URL in src/config/subgraphEndpoints.js is derived from it, so
# this is the single knob for pointing the app at a different backend.
# NOTE: NEXT_PUBLIC_* values are inlined at build time (static export), so
# changing this requires a rebuild.
NEXT_PUBLIC_FUTARCHY_API_URL=https://api.futarchy.fi
NEXT_PUBLIC_API_URL=https://stag.api.tickspread.com
NEXT_PUBLIC_DEBUG_MODE=false
NEXT_PUBLIC_API_VERSION=v1
NEXT_PUBLIC_USE_DEFAULT_MOCK_METADATA=true
# RPC endpoints. Each is optional: when set it is tried FIRST and the public
# endpoints stay behind it as fallbacks, so a paid endpoint hitting its rate
# limit degrades instead of taking the app down.
#   NEXT_PUBLIC_GNOSIS_RPC       Gnosis (chain 100) — wallet transport, on-chain reads
#   NEXT_PUBLIC_MAINNET_RPC_URL  Ethereum (chain 1)
#   NEXT_PUBLIC_RPC_URL          Gnosis, used by the active-market reserve reads
# Note: these are inlined at build time, so changing one needs a rebuild.
NEXT_PUBLIC_RPC_URL=https://rpc.gnosischain.com
# NEXT_PUBLIC_GNOSIS_RPC=
# NEXT_PUBLIC_MAINNET_RPC_URL=
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_DATA_SOURCE=supabase
NEXT_PUBLIC_USE_MOCK_SNAPSHOT=false
