NEXT_PUBLIC_GA_MEASUREMENT_ID=G-QC4HGQV878
NEXT_PUBLIC_DEBUG_MODE=false
NEXT_PUBLIC_API_VERSION=v1
NEXT_PUBLIC_USE_DEFAULT_MOCK_METADATA=true
# RPC endpoints. These are the names the app reads (see config/rpcEndpoints.js);
# NEXT_PUBLIC_RPC_URL was never read by any code and has been removed.
# Values are inlined at BUILD time, so a private endpoint must be present in
# the environment that runs `next build`, not only at deploy time.
# Leave blank to fall back to the public endpoint.
NEXT_PUBLIC_GNOSIS_RPC_URL=
NEXT_PUBLIC_MAINNET_RPC_URL=
NEXT_PUBLIC_USE_MOCK_SNAPSHOT=false
